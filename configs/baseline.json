{
  "task": "classification",
  "run": {
    "name": "sailor2-baseline-seed42",
    "output_root": "/kaggle/output",
    "device": "cuda",
    "world_size": 2,
    "seed": 42
  },
  "data": {
    "path": null,
    "filename": "VGEC 2026_v1.json",
    "correction_path": null,
    "correction_filename": "VGEC_balanced.json",
    "input_root": "/kaggle/input",
    "validation_fraction": 0.2,
    "augmentation_path": null,
    "augmentation_filename": "VGEC_classifier.json"
  },
  "model": {
    "name": "sail/Sailor2-8B-Chat",
    "revision": "577d5b2745863cec11e1b2f1c92586a91cea446e",
    "load_in_4bit": true,
    "compute_dtype": "bfloat16",
    "quant_type": "nf4",
    "use_double_quant": true,
    "attn_implementation": "sdpa"
  },
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "bias": "none",
    "modules_to_save": [
      "score"
    ]
  },
  "training": {
    "max_length": 512,
    "effective_batch_size": 8,
    "fp16_initial_scale": 1,
    "class_weight_power": 0.5,
    "args": {
      "num_train_epochs": 5,
      "max_steps": -1,
      "per_device_train_batch_size": 1,
      "per_device_eval_batch_size": 1,
      "learning_rate": 5e-05,
      "weight_decay": 0.01,
      "warmup_steps": 30,
      "gradient_checkpointing": true,
      "gradient_checkpointing_kwargs": {
        "use_reentrant": false
      },
      "optim": "paged_adamw_8bit",
      "logging_steps": 10,
      "dataloader_num_workers": 0,
      "lr_scheduler_type": "cosine",
      "max_grad_norm": 1,
      "adam_beta1": 0.9,
      "adam_beta2": 0.999,
      "adam_epsilon": 1e-08
    }
  },
  "oof": {
    "enabled": true,
    "folds": 5,
    "epochs": 3
  }
}
