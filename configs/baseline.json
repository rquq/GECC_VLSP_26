{
  "run": {
    "name": "vgec-full",
    "output_root": "runs",
    "device": "cuda",
    "seeds": [42, 43, 44],
    "archive": true
  },
  "data": {
    "path": null,
    "filename": "VGEC 2026_v1.json",
    "input_root": "/kaggle/input",
    "validation_fraction": 0.2,
    "train_limit": null,
    "validation_limit": null
  },
  "model": {
    "name": "Qwen/Qwen3-4B-Instruct-2507",
    "revision": "cdbee75f17c01a7cc42f958dc650907174af0554",
    "load_in_4bit": true,
    "compute_dtype": "auto",
    "quant_type": "nf4",
    "use_double_quant": true,
    "attn_implementation": "sdpa"
  },
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "bias": "none"
  },
  "training": {
    "max_length": 512,
    "effective_batch_size": 8,
    "fp16_initial_scale": 4096.0,
    "args": {
      "num_train_epochs": 3,
      "max_steps": -1,
      "per_device_train_batch_size": 1,
      "learning_rate": 0.00005,
      "warmup_ratio": 0.1,
      "weight_decay": 0.01,
      "gradient_checkpointing": true,
      "gradient_checkpointing_kwargs": {"use_reentrant": false},
      "optim": "adamw_torch",
      "logging_steps": 1,
      "dataloader_num_workers": 0,
      "lr_scheduler_type": "linear",
      "max_grad_norm": 1.0,
      "adam_beta1": 0.9,
      "adam_beta2": 0.999,
      "adam_epsilon": 1e-8
    }
  },
  "generation": {
    "max_new_tokens": 192,
    "do_sample": false,
    "use_cache": true
  },
  "prompt": "Bạn sửa lỗi ngữ pháp tiếng Việt và phân loại lỗi. Chỉ trả lời một đối tượng JSON với hai khóa error_type_id và corrected_sentence. error_type_id là một số nguyên thuộc [0, 1, 2, 3, 4]. Nhãn 0: câu không có lỗi, giữ nguyên câu. Nhãn 1: lỗi cấu trúc câu (thiếu hoặc sai quan hệ chủ ngữ, vị ngữ, các vế câu). Nhãn 2: lỗi cấu trúc ngữ đoạn (sắp xếp hoặc kết hợp thành phần trong cụm từ). Nhãn 3: lỗi về sử dụng từ công cụ (quan hệ từ, liên từ, từ phụ trợ). Nhãn 4: lỗi cách chấm câu (thiếu, thừa hoặc dùng sai dấu câu). Sửa ít nhất có thể, giữ nguyên ý nghĩa; không giải thích.",
  "evaluation": {
    "selection_metrics": ["classification.macro_f1", "corrections.error_only.gleu_plus"],
    "save_epoch_adapters": true
  }
}
