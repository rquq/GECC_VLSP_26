{
  "task": "classification",
  "run": {
    "name": "hierarchical-localization-beta",
    "output_root": "runs",
    "device": "cuda",
    "seed": 42
  },
  "data": {
    "path": null,
    "filename": "VGEC 2026_v1.json",
    "input_root": "/kaggle/input",
    "validation_fraction": 0.2,
    "correction_path": null,
    "correction_filename": "VGEC_balanced.json",
    "augmentation_path": null,
    "augmentation_filename": "VGEC_classifier.json"
  },
  "model": {
    "name": "Qwen/Qwen3-4B-Instruct-2507",
    "revision": "cdbee75f17c01a7cc42f958dc650907174af0554",
    "load_in_4bit": true,
    "compute_dtype": "bfloat16",
    "quant_type": "nf4",
    "use_double_quant": true,
    "attn_implementation": "sdpa"
  },
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "bias": "none",
    "modules_to_save": ["score"]
  },
  "training": {
    "max_length": 512,
    "effective_batch_size": 8,
    "fp16_initial_scale": 1.0,
    "class_weight_power": 0.5,
    "args": {
      "num_train_epochs": 5,
      "max_steps": -1,
      "per_device_train_batch_size": 1,
      "per_device_eval_batch_size": 1,
      "learning_rate": 2e-5,
      "weight_decay": 0.01,
      "warmup_steps": 0.1,
      "gradient_checkpointing": true,
      "gradient_checkpointing_kwargs": {
        "use_reentrant": false
      },
      "optim": "adamw_torch",
      "logging_steps": 1,
      "dataloader_num_workers": 0,
      "lr_scheduler_type": "linear",
      "max_grad_norm": 1.0,
      "adam_beta1": 0.9,
      "adam_beta2": 0.999,
      "adam_epsilon": 1e-8
    }
  },
  "oof": {
    "enabled": true,
    "folds": 5,
    "epochs": 3
  }
}
